{
  "agent": "lead",
  "permissions": {
    "allow": [
      "Bash(git *)",
      "Bash(ls*)",
      "Bash(cat*)",
      "Bash(mkdir*)",
      "Bash(python*)",
      "Bash(pytest*)",
      "Bash(pip *)",
      "Bash(ruff*)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(node*)",
      "Bash(code-review-graph*)",
      "mcp__code-review-graph"
    ],
    "deny": [
      "Bash(git push*)",
      "Bash(git reset --hard*)",
      "Bash(git clean*)",
      "Bash(rm -rf*)",
      "Bash(sudo*)",
      "Bash(curl*)",
      "Bash(wget*)",
      "Read(.env*)",
      "Read(**/secrets/**)"
    ]
  },
  "env": {
    "PONYTAIL_DEFAULT_MODE": "full",
    "CRG_HOOK_WORKTREES": "1"
  },
  "extraKnownMarketplaces": {
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    }
  },
  "enabledPlugins": {
    "ponytail@ponytail": true
  },
  "enableAllProjectMcpServers": false,
  "enabledMcpjsonServers": [
    "code-review-graph"
  ]
}
